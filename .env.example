# Kết nối PostgreSQL (Native Windows Port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tipitaka_ai

# Gemini API Key (Điền API Key của bạn để sử dụng AI Dịch thuật & Mở rộng từ khóa)
GEMINI_API_KEY=

# Cấu hình AI & Tìm kiếm
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=12000

# Tắt Vector vì chạy thuần Text + AI Gemini (Không cần Docker / pgvector)
PY_SEARCH_ENABLE_VECTOR=false

# Chế độ AI (full: Dùng AI mở rộng từ khóa + Rerank kết quả + Dịch thuật)
PY_SEARCH_AI_MODE=full

PY_SEARCH_MIN_SCORE=0.0
PY_SEARCH_RERANK_LIMIT=100
GA_MEASUREMENT_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# Khoa ky session (dang nhap admin + dang nhap khach). BAT BUOC dat gia tri co dinh o day,
# khong de trong: khong dat thi moi lan restart server (kem ca --reload luc dev, va moi
# lan deploy_vps.bat tren VPS) se sinh key ngau nhien khac, dang xuat toan bo admin lan
# khach dang dang nhap ma khong bao truoc. Sinh 1 lan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
