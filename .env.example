# Local:
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/tipitaka_ai
# Vercel/Supabase:
# Use the Supabase Postgres/pooler URL with sslmode=require.
# If the copied URL contains Prisma params like pgbouncer=true or connection_limit=1,
# the Python app will strip unsupported params before connecting.
GEMINI_API_KEY=
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash,gemini-2.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=12000
PY_SEARCH_MIN_SCORE=0.0
PY_SEARCH_ENABLE_VECTOR=true
PY_SEARCH_AI_MODE=full
PY_SEARCH_RERANK_LIMIT=100
GA_MEASUREMENT_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
