# Dependencies
node_modules/
.venv/
venv/
env/

# Environment files / secrets
# .env chứa GEMINI_API_KEY và ADMIN_PASSWORD - tuyệt đối không đẩy lên.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Gồm cả uvicorn_8001.log và các log nạp dữ liệu sinh ra khi chạy import_*.py
*.log
*.sql
# Database Dumps and Large Archives
# Luật `*.sql` cũng chặn luôn export_data.sql (hiện khoảng 180 MB) - bản xuất dữ liệu
# để đẩy sang VPS,
# chuyển bằng tay chứ không đi qua kho mã nguồn.

*.dump
*.dump.*
*.bak
*.sqlite
*.sqlite3
*.db
*.zip
*.rar
*.tar
*.gz
*.7z
# 001_init.sql là bản chụp lược đồ, đã được theo dõi từ trước nên luật trên không ảnh
# hưởng. Ghi lại ở đây để sau này khỏi tưởng nó bị bỏ sót.

# Dữ liệu tải về / sinh ra khi chạy, đều lấy lại được
# 121 MB PDF tải từ tamtangpaliviet.net, import_indacanda.py tự tải lại nếu thiếu.
.indacanda_pdf/
# Đệm vector khi nhúng đoạn kinh.
.embed_cache/
# PDF khác lỡ để trong thư mục làm việc.
*.pdf

# Nội dung bảng thông báo do quản trị viên sửa lúc chạy.
# VPS deploy bằng `git pull`; theo dõi file này thì mỗi lần khách đổi thông báo trên
# /admin/notice là lần pull sau bị xung đột. `app/notice.py` có DEFAULT_NOTICE nên
# thiếu file vẫn chạy đúng.
app/data/notice.json

# win-acme tải về khi chạy setup_ssl.bat
wacs/
*.pfx

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json

# Temporary QA / local artifacts
tmp/
temp/
.tmp/
indacanda_full_preview/
export_data_before_spacing_fix.sql

# Kết quả các script `dev_*.py` ghi ra JSON. Chúng là ẢNH CHỤP một lần đo, phụ thuộc trạng
# thái DB lúc chạy, nên đưa vào kho mã nguồn chỉ gây nhiễu diff và dễ bị đọc như số liệu
# hiện hành. Chạy lại script là có bản mới.
reader_unit_check*.json
reader_units_*.json
dev_*_report.json
dev_*_audit.json
coverage_report.json

# Script/file dùng một lần để dò hoặc sửa trực tiếp DB local. Logic cần giữ phải được
# chuyển vào importer, migration hoặc test có tên rõ ràng trước khi commit.
scratch_*.py
fix_text*.py
append_text.py
check_db.py
check_unresolved.py
sample*.txt
*_output.txt
vin01m.xml

# Bản dump DB nội bộ (tipitaka-data.dump ~104 MB). Chuyển bằng tay như export_data.sql.
*.dump

# 5 file rỗng từng bị commit do lỡ gõ lệnh (`cd`, `git`) hoặc lỡ dán chữ (`rẳng`, `tuốt`,
# `nghĩahội`) - đã `git rm`. Không có mẫu nào chặn được loại này, nên khi thấy file lạ
# 0 byte trong `git status` thì xoá, đừng commit.
